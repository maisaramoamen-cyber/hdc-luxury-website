{
  "name": "hdc-luxury-website",
  "version": "1.0.0",
  "description": "Hamido Dental Clinics - Luxury Website with Color Psychology",
  "main": "src/index.tsx",
  "scripts": {
    "dev": "vite",
    "dev:sandbox": "wrangler pages dev dist --ip 0.0.0.0 --port 3000",
    "build": "vite build",
    "preview": "wrangler pages dev dist",
    "deploy": "npm run build && wrangler pages deploy dist",
    "deploy:prod": "npm run build && wrangler pages deploy dist --project-name hamido-dental-luxury",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "clean-port": "fuser -k 3000/tcp 2>/dev/null || true",
    "test": "curl http://localhost:3000",
    "start": "pm2 start ecosystem.config.cjs",
    "stop": "pm2 stop ecosystem.config.cjs"
  },
  "dependencies": {
    "hono": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250705.0",
    "@hono/vite-cloudflare-pages": "^0.4.2",
    "vite": "^5.0.0",
    "wrangler": "^3.78.0",
    "typescript": "^5.0.0"
  },
  "keywords": [
    "luxury-dentistry",
    "color-psychology", 
    "hono",
    "cloudflare-pages",
    "dental-website",
    "hamido-dental"
  ],
  "author": "Crystal Power Investments",
  "license": "MIT"
}